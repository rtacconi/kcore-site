[0.4,"o","$ qemu-img info windows-server-2022.qcow2\r\n"]
[1.2,"o","image: windows-server-2022.qcow2\r\nfile format: qcow2\r\nvirtual size: 40 GiB\r\n"]
[2.2,"o","$ kctl --node 192.168.40.107:9091 node upload-image \\\r\n"]
[2.6,"o","    -f windows-server-2022.qcow2 --name windows-server-2022.qcow2 --format qcow2\r\n"]
[4.8,"o","path:   /var/lib/kcore/images/windows-server-2022.qcow2\r\nformat: qcow2\r\n"]
[5.8,"o","$ kctl create vm win-01 \\\r\n"]
[6.2,"o","    --cpu 2 --memory 4G --network default \\\r\n"]
