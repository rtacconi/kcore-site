[15.4,"o","$ kcore-kctl create vm debian12-01 \\\r\n"]
[16.0,"o","  --target-node kvm-node-01 \\\r\n  --image https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2 \\\r\n  --image-sha256 <sha256> \\\r\n  --storage-backend filesystem \\\r\n  --storage-size-bytes 42949672960 \\\r\n  --ssh-key operator-key \\\r\n  --wait --wait-timeout-seconds 300\r\n"]
[19.1,"o","vm/debian12-01 created\r\nvm/debian12-01 status: running\r\n\r\n"]
